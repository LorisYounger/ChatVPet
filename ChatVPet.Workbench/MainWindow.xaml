<Window x:Class="ChatVPet.Workbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChatVPet Lab · 测试工作台" Width="1480" Height="940" MinWidth="1100" MinHeight="680"
 Background="#18191C" Foreground="#EBEDF2" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9298A5" />
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9ECF3"/><Setter Property="Background" Value="#292D35"/>
   <Setter Property="BorderBrush" Value="#3A404D"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#6C9CF5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#22252B"/><Setter Property="Foreground" Value="#E6EAF2"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#363C48"/><Setter Property="Padding" Value="10"/><Setter Property="SelectionBrush" Value="#385F9D"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9DEE8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="item" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#303744"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="BorderBrush" Value="#49576C"/><Setter TargetName="item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#1D2026"/><Setter Property="BorderBrush" Value="#30343E"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#BEC5D2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Padding="13,11" Background="#21242A" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="BorderBrush" Value="#6F9CFF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="236" MinWidth="200"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="5"/><ColumnDefinition Width="455" MinWidth="330"/></Grid.ColumnDefinitions>
  <Border Background="#202125" BorderBrush="#303238" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,20,14,12">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="◈  ChatVPet Lab" FontSize="21" FontWeight="SemiBold" Margin="8,0,0,4"/>
     <TextBlock Text="对话 · 检索 · 插件" Foreground="{StaticResource Muted}" Margin="9,0,0,22"/>
     <Button Content="＋  新建测试会话" Click="New_Click" Background="#304E79"/>
     <Button Content="基础协议与插件测试" Click="Baseline_Click"/>
     <Button Content="少压缩 / 多压缩对照" Click="Compression_Click"/>
     <TextBlock Text="测试会话" Foreground="{StaticResource Muted}" Margin="10,26,0,8"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,0">
     <TextBlock Text="●  隔离宿主" Foreground="#87CDB2"/>
     <TextBlock x:Name="ApiAddress" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
     <Button Content="打开测试数据目录" Click="Folder_Click" Margin="0,12,0,0"/>
    </StackPanel>
    <ListBox x:Name="SessionsList" SelectionChanged="Session_Selected" DisplayMemberPath="Label"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="#30343D" BorderThickness="0,0,0,1" Padding="22,20">
    <StackPanel><TextBlock x:Name="SessionTitle" Text="观察一次完整对话" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="SessionStatus" Text="新建会话，或运行一组预设测试" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="24,16">
    <StackPanel>
     <Border x:Name="Welcome" Background="#22262E" CornerRadius="12" Padding="24" Margin="0,28,0,22">
      <StackPanel><TextBlock Text="把问题看到底" FontSize="25" Margin="0,0,0,16"/>
       <TextBlock Text="从玩家输入到最终回复，查看每一步使用了什么证据。" TextWrapping="Wrap" Foreground="#BEC7D6" LineHeight="25"/>
       <TextBlock Text="01   检查 RAG 候选与重排分数&#10;02   查看模型实际收到的完整消息&#10;03   核对 Process 分支和插件回执&#10;04   从同一存档运行单变量对照" TextWrapping="Wrap" Foreground="#8DA9CF" LineHeight="31" Margin="0,20,0,0"/>
      </StackPanel>
     </Border>
     <ItemsControl x:Name="ChatItems">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border CornerRadius="10" Padding="16" Margin="0,8" MaxWidth="760">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#202329"/><Setter Property="HorizontalAlignment" Value="Left"/>
         <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="user"><Setter Property="Background" Value="#244675"/><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="error"><Setter Property="Background" Value="#502D33"/></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <StackPanel><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#A7B5CB" Margin="0,0,0,7"/>
         <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="14"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Margin="22,10,22,20" Background="#292C33" CornerRadius="12" Padding="12">
    <StackPanel>
     <TextBlock x:Name="Attachment" Foreground="#9BBCEF" FontSize="11" Visibility="Collapsed"/>
     <TextBox x:Name="Input" MinHeight="64" MaxHeight="170" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" ToolTip="Ctrl+Enter 发送；多行内容作为同一条消息" PreviewKeyDown="Input_KeyDown"/>
     <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="StopButton" Content="停止" Click="Stop_Click"/><Button x:Name="SendButton" Content="发送 ↑" Background="#315F9E" Click="Send_Click"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Button Content="＋ 图片" Click="Image_Click"/><Button Content="续答重试" Click="Retry_Click"/></StackPanel>
     </DockPanel>
    </StackPanel>
   </Border>
  </Grid>
  <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="#30343D"/>
  <Grid Grid.Column="3" Background="#1D2026">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="17,18,12,12"><Button Content="导出记录" DockPanel.Dock="Right" Click="Export_Click"/><TextBlock Text="诊断面板" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <TabControl Grid.Row="1" Margin="8,0,8,12">
    <TabItem Header="过程"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="5"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,8"><Button DockPanel.Dock="Right" Content="复制" Click="Copy_Click"/><Button DockPanel.Dock="Right" Content="原始 / 阅读" Click="Raw_Click"/><ComboBox x:Name="Filter" SelectedIndex="0" SelectionChanged="Filter_Changed" VerticalAlignment="Center"><ComboBoxItem Content="全部步骤"/><ComboBoxItem Content="模型请求"/><ComboBoxItem Content="RAG / 重排"/><ComboBoxItem Content="摘要"/><ComboBoxItem Content="插件 / 回执"/><ComboBoxItem Content="错误 / 复核"/></ComboBox></DockPanel>
     <ListBox Grid.Row="1" x:Name="EventsList" SelectionChanged="Event_Selected" DisplayMemberPath="Label"/>
     <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#343A46"/>
     <TextBox Grid.Row="3" x:Name="Detail" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
    </Grid></TabItem>
    <TabItem Header="上下文"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="本轮最终上下文、摘要、回执与宿主状态。&#10;完整 system / history / input 见模型请求。" Foreground="{StaticResource Muted}" Margin="0,12" TextWrapping="Wrap"/>
     <TextBox Grid.Row="1" x:Name="ContextDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"/>
    </Grid></TabItem>
    <TabItem Header="对照"><StackPanel Margin="16">
     <TextBlock Text="固定当前存档，再问同一个问题" FontSize="15" Margin="0,12"/>
     <TextBlock Text="填写下方消息，选择对照变量。每组都会保留基线；源会话保持原样。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <ComboBox x:Name="Variant" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="关闭知识 / 记忆 RAG" Tag="no-rag"/><ComboBoxItem Content="关闭重排" Tag="no-rerank"/><ComboBoxItem Content="摘要换为完整历史" Tag="no-summary"/><ComboBoxItem Content="换用完整兼容提示词" Tag="compatibility"/></ComboBox>
     <Button Content="用输入框消息开始对照" Click="Compare_Click"/>
     <TextBlock Text="对照结果会出现在左侧独立会话中。差异只提示可能影响因素；需结合实际送入模型的证据判断。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,26"/>
     <TextBlock Text="人工分析 / 待修复项" Margin="0,0,0,10"/>
     <TextBox x:Name="Note" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <Button Content="保存分析到当前记录" Click="Note_Click"/>
    </StackPanel></TabItem>
    <TabItem Header="插件"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="VPet.Plugin.ChatVPet" FontSize="16" Margin="0,12"/>
      <TextBlock Text="实际插件的模型调用、工具与回执。&#10;余额 / 背包 / 保存由隔离测试宿主提供。&#10;动画、游戏语音和完整 TalkBox 尚未挂载。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <WrapPanel><Button Content="插件设置窗口" Click="PluginSettings_Click"/><Button Content="插件日记窗口" Click="PluginDiary_Click"/><Button Content="插件购买自检" Click="PluginCheck_Click"/></WrapPanel>
      <TextBlock Text="当前配置 (密钥不显示)" Margin="0,18,0,10"/>
     </StackPanel><TextBox Grid.Row="1" x:Name="ConfigDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"/>
    </Grid></TabItem>
   </TabControl>
  </Grid>
 </Grid>
</Window>
