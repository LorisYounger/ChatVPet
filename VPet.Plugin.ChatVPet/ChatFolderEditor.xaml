<UserControl x:Class="VPet.Plugin.ChatVPet.ChatFolderEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
    xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI">
    <StackPanel>
        <ListBox x:Name="Folders" MinHeight="48" MaxHeight="126"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch" VirtualizingStackPanel.IsVirtualizing="False"
                 AlternationCount="{Binding Items.Count, RelativeSource={RelativeSource Self}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="3,2" ToolTip="{Binding}">
                        <TextBlock DockPanel.Dock="Right" Text="{ll:Str 默认写入}" FontWeight="SemiBold" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,5,0,2">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,5,3" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="pu:ButtonHelper.CornerRadius" Value="4" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="{ll:Str 添加文件夹}" Click="AddFolder" />
            <Button x:Name="DefaultButton" Content="{ll:Str 设为默认}" Click="SetDefault" />
            <Button x:Name="RemoveButton" Content="{ll:Str 移除}" Click="RemoveFolder" />
        </WrapPanel>
    </StackPanel>
</UserControl>
